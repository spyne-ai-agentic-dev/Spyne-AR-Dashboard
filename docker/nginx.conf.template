# nginx fronts Streamlit so the container can expose the platform health check.
# Streamlit (Tornado) cannot register custom routes, so nginx answers
# /agentic-dev/api/v1/health itself and proxies everything else to Streamlit.
# Rendered by entrypoint.sh via envsubst (only ${PORT} and ${SERVICE_NAME}).

worker_processes  1;
pid               /tmp/nginx.pid;
error_log         /dev/stderr warn;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;

    # Run fully non-root: keep every writable path under /tmp.
    client_body_temp_path /tmp/nginx-client-body;
    proxy_temp_path       /tmp/nginx-proxy;
    fastcgi_temp_path     /tmp/nginx-fastcgi;
    uwsgi_temp_path       /tmp/nginx-uwsgi;
    scgi_temp_path        /tmp/nginx-scgi;

    sendfile           on;
    keepalive_timeout  65;
    client_max_body_size 32m;

    upstream streamlit {
        server 127.0.0.1:8501;
    }

    server {
        listen      ${PORT};
        server_name _;

        # ── Platform health check (exact path required by the ALB/ECS) ────────
        location = /agentic-dev/api/v1/health {
            access_log off;
            default_type application/json;
            return 200 '{"status":"healthy","service":"${SERVICE_NAME}","timestamp":"$time_iso8601"}';
        }

        # ── Everything else → Streamlit (WebSocket upgrade required) ─────────
        location / {
            proxy_pass http://streamlit;
            proxy_http_version 1.1;

            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        "upgrade";
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Streamlit holds a long-lived websocket per session.
            proxy_read_timeout  3600s;
            proxy_send_timeout  3600s;
            proxy_buffering     off;
        }
    }
}
